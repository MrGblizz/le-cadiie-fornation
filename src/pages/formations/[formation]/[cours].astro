---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Quiz from '../../../components/Quiz.astro';
import {
  MODALITES,
  NIVEAUX,
  catalogue,
  formatDuree,
  formatJours,
  fragmentHtml,
  markdown,
  media,
  resoudreCours,
  stylesDe,
  video,
  type Cours,
} from '../../../lib/formations';

export async function getStaticPaths() {
  const { cours } = await catalogue();
  return cours.map((c) => ({ params: { formation: c.formation.id, cours: c.slug }, props: { cours: c } }));
}

interface Props {
  cours: Cours;
}
const { cours } = Astro.props;
const { cours: tousLesCours } = await catalogue();
const d = cours.data;
const formation = cours.formation;
const id = cours.id;

// CSS de la formation puis du cours (le second l'emporte)
const css = [stylesDe(formation.id), stylesDe(id)].filter(Boolean).join('\n');

// Cours à réviser si le quiz de début échoue : prérequis + cours cités dans les questions
const aReviser = new Map(cours.dependances.map((c) => [c.id, c]));
for (const q of d.quiz_debut?.questions ?? []) {
  if (!q.dependance) continue;
  const c = tousLesCours.find((x) => x.id === resoudreCours(q.dependance!, formation.id));
  if (c) aReviser.set(c.id, c);
}

const debloque = tousLesCours.filter((c) => c.dependances.some((dep) => dep.id === id));

const sections = d.contenu.map((s, i) => ({
  ancre: `section-${i + 1}`,
  titre: s.titre,
  texte: markdown(s.texte),
  html: fragmentHtml(id, s.html),
  image: s.image,
  legende: s.legende,
  video: video(id, s.video),
  son: media(id, s.son),
}));
---

<Base titre={`${d.nom} · ${formation.data.nom}`} description={d.resume}>
  <Fragment slot="filtres">
    <h2>Dans ce cours</h2>
    <ol>
      {d.quiz_debut && <li><a href="#quiz-debut">Quiz de début</a></li>}
      {
        sections.map((s) => (
          <li>
            <a href={`#${s.ancre}`}>{s.titre}</a>
          </li>
        ))
      }
      {d.quiz_fin && <li><a href="#quiz-fin">Quiz de fin</a></li>}
    </ol>
    <h2 class="titre-formation">Formation : {formation.data.nom}</h2>
    <ol class="cours-formation">
      {
        formation.cours.map((c) => (
          <li>
            {c.id === id ? <strong>{c.data.nom}</strong> : <a href={c.url}>{c.data.nom}</a>}
          </li>
        ))
      }
    </ol>
  </Fragment>

  {/* Placé dans le corps (et non dans <head>) pour passer après le CSS global et bien l'écraser. */}
  {css && <Fragment set:html={`<style data-styles-cours>${css}</style>`} />}

  <article class="cours">
    <nav class="fil" aria-label="Fil d'Ariane">
      <a href="/formations/">Formations</a> › <a href={formation.url}>{formation.data.nom}</a> › Cours {cours.numero}/{
        formation.cours.length
      }
    </nav>

    <header class="entete-cours">
      {d.image && <Image src={d.image} alt="" class="couverture" width={900} />}
      <div class="pastilles">
        <span class={`pastille niveau-${cours.niveau}`}>{NIVEAUX[cours.niveau]}</span>
        <span class="pastille">Cours {cours.numero} de la formation « {formation.data.nom} »</span>
      </div>
      <h1>{d.nom}</h1>
      <p class="resume">{d.resume}</p>

      <dl class="infos">
        <div>
          <dt>📖 Lecture</dt>
          <dd>{formatDuree(d.temps.lecture)}</dd>
        </div>
        <div>
          <dt>✍️ En le faisant</dt>
          <dd>{formatDuree(d.temps.pratique)}</dd>
        </div>
        <div>
          <dt>🎯 Maîtrise</dt>
          <dd>{formatJours(d.temps.maitrise)} de pratique</dd>
        </div>
      </dl>

      <p class={`modalite modalite-${d.modalite}`}>
        {d.modalite === 'terrain' ? '⚠️' : d.modalite === 'support' ? '🏫' : '🏠'}
        {MODALITES[d.modalite].long}.
      </p>

      {
        cours.dependances.length > 0 && (
          <p class="prerequis">
            <strong>Prérequis :</strong>
            {cours.dependances.map((dep, i) => (
              <>
                {i > 0 && ', '}
                <a href={dep.url}>{dep.data.nom}</a>
                {dep.formation.id !== formation.id && <small> ({dep.formation.data.nom})</small>}
              </>
            ))}
          </p>
        )
      }
    </header>

    {
      d.quiz_debut && (
        <Quiz
          type="debut"
          cours={id}
          quiz={d.quiz_debut}
          dependances={[...aReviser.values()].map((c) => ({ id: c.id, nom: c.data.nom, url: c.url }))}
        />
      )
    }

    {
      sections.map((s) => (
        <section class="section-cours" id={s.ancre}>
          <h2>{s.titre}</h2>
          {s.texte && <div class="prose" set:html={s.texte} />}
          {s.html && <div class="fragment-html" set:html={s.html} />}
          {s.image && (
            <figure>
              <Image src={s.image} alt={s.legende ?? ''} />
              {s.legende && <figcaption>{s.legende}</figcaption>}
            </figure>
          )}
          {s.video?.type === 'iframe' && (
            <div class="video">
              <iframe
                src={s.video.src}
                title={`Vidéo : ${s.titre}`}
                loading="lazy"
                allow="fullscreen; picture-in-picture"
                allowfullscreen
              />
            </div>
          )}
          {s.video?.type === 'fichier' && <video src={s.video.src} controls preload="metadata" />}
          {s.son && <audio src={s.son} controls preload="none" />}
        </section>
      ))
    }

    {d.quiz_fin && <Quiz type="fin" cours={id} quiz={d.quiz_fin} />}

    <nav class="suivant-precedent" aria-label="Cours de la formation">
      {cours.precedent ? <a class="bouton secondaire" href={cours.precedent.url}>← {cours.precedent.data.nom}</a> : <span />}
      {
        cours.suivant ? (
          <a class="bouton" href={cours.suivant.url}>
            Cours suivant : {cours.suivant.data.nom} →
          </a>
        ) : (
          <a class="bouton" href={formation.url}>
            Fin de la formation ✓
          </a>
        )
      }
    </nav>

    {
      debloque.length > 0 && (
        <aside class="suite">
          <h2>Et ensuite ?</h2>
          <p>Ce cours ouvre la voie à :</p>
          <ul>
            {debloque.map((c) => (
              <li>
                <a href={c.url}>{c.data.nom}</a> <small>({c.formation.data.nom})</small> — {c.data.resume}
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </article>
</Base>

<style>
  .fil {
    font-size: 0.9rem;
    color: var(--texte-doux);
    margin-bottom: 1rem;
  }
  .entete-cours {
    margin-bottom: 2.5rem;
  }
  .couverture {
    width: 100%;
    height: auto;
    max-height: 320px;
    object-fit: cover;
    border-radius: var(--rayon);
    margin-bottom: 1rem;
  }
  .pastilles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin: 0.5rem 0;
  }
  .resume {
    font-size: 1.15rem;
    color: var(--texte-doux);
    max-width: 65ch;
  }
  .infos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin: 1.25rem 0;
  }
  .infos div {
    background: var(--surface);
    border: 1px solid var(--bordure);
    border-radius: var(--rayon);
    padding: 0.6rem 0.8rem;
  }
  .infos dt {
    font-size: 0.8rem;
    color: var(--texte-doux);
  }
  .infos dd {
    margin: 0;
    font-weight: 700;
  }
  .modalite {
    padding: 0.6rem 0.9rem;
    border-radius: var(--rayon);
    background: var(--accent-clair);
  }
  .modalite-terrain {
    background: #fff3cd;
    font-weight: 600;
  }
  .section-cours {
    margin: 0 0 2.5rem;
  }
  .section-cours h2 {
    font-size: 1.6rem;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 0.3rem;
  }
  figure {
    margin: 1rem 0;
  }
  figure :global(img) {
    height: auto;
    border-radius: var(--rayon);
  }
  figcaption {
    font-size: 0.85rem;
    color: var(--texte-doux);
  }
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    margin: 1rem 0;
  }
  .video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: var(--rayon);
  }
  video,
  audio {
    display: block;
    width: 100%;
    margin: 1rem 0;
  }
  .suivant-precedent {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 0 0 2.5rem;
  }
  .suite {
    background: var(--surface);
    border: 1px dashed var(--accent);
    border-radius: var(--rayon);
    padding: 1rem 1.5rem;
  }
  .titre-formation {
    margin-top: 1.2rem !important;
  }
  @media (max-width: 640px) {
    .infos {
      grid-template-columns: 1fr;
    }
  }
</style>
